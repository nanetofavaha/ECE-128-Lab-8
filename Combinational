module multiplier_comb(a, b, p);
    input [3:0] a, b;
    output [7:0] p;
    wire [3:0] m0;
    wire [4:0] m1;
    wire [5:0] m2;
    wire [6:0] m3;
    wire [7:0] s1, s2, s3;

    assign m0 = b[0] ? a : 4'd0;
    assign m1 = b[1] ? {a, 1'b0} : 5'd0;
    assign m2 = b[2] ? {a, 2'b00} : 6'd0;
    assign m3 = b[3] ? {a, 3'b000} : 7'd0;

    assign s1 = {4'd0, m0} + {3'd0, m1};
    assign s2 = s1 + {2'd0, m2};
    assign s3 = s2 + {1'b0, m3};
    assign p = s3;
endmodule

