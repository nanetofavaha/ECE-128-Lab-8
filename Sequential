
`timescale 1ns / 1ps

// Direct board connections. 
module lab8_seq_top(clk, reset, start, sw, led, busy, done);
    input clk, reset, start;
    input [7:0] sw;
    output [7:0] led;
    output busy, done;

    multiplier_seq multiplier (
        .clk(clk),
        .reset(reset),
        .start(start),
        .a(sw[3:0]),
        .b(sw[7:4]),
        .product(led),
        .busy(busy),
        .done(done)
    );
endmodule

// Four-state shift-and-add multiplier following the lecture skeleton.
module multiplier_seq(clk, reset, start, a, b, product, busy, done);
    input clk, reset, start;
    input [3:0] a, b;
    output reg [7:0] product;
    output busy;
    output reg done;

    parameter S0_idle = 0,
              S1_multiply = 1,
              S2_update_result = 2,
              S3_done = 3;

    reg [2:0] CS, NS;
    reg [7:0] partial_product;
    reg [7:0] multiplicand;
    reg [3:0] operand_b;
    reg [2:0] shift_count; // Must represent 4, not just 0 through 3.

    assign busy = (CS != S0_idle);

    // Combinational next-state logic uses blocking assignments.
    always @(*) begin
        NS = CS;
        case (CS)
            S0_idle: begin
                if (start == 1'b1)
                    NS = S1_multiply;
            end
            S1_multiply: begin
                NS = S2_update_result;
            end
            S2_update_result: begin
                if (shift_count == 3'd4)
                    NS = S3_done;
                else
                    NS = S1_multiply;
            end
            S3_done: begin
                NS = S0_idle;
            end
            default: NS = S0_idle;
        endcase
    end

    // State and datapath registers update only on the clock edge.
    always @(posedge clk) begin
        if (reset == 1'b1) begin
            CS <= S0_idle;
            partial_product <= 8'd0;
            shift_count <= 3'd0;
            multiplicand <= 8'd0;
            operand_b <= 4'd0;
            product <= 8'd0;
            done <= 1'b0;
        end else begin
            CS <= NS;
            case (CS)
                S0_idle: begin
                    if (start == 1'b1) begin
                        partial_product <= 8'd0;
                        shift_count <= 3'd0;
                        multiplicand <= {4'd0, a};
                        operand_b <= b;
                        done <= 1'b0;
                    end
                end
                S1_multiply: begin
                    if (shift_count < 3'd4) begin
                        if (operand_b[0] == 1'b1)
                            partial_product <= partial_product + multiplicand;
                        // For a zero bit, keep the current partial product.
                        shift_count <= shift_count + 3'd1;
                        multiplicand <= multiplicand << 1;
                        operand_b <= operand_b >> 1;
                    end
                end
                S2_update_result: begin
                    if (shift_count == 3'd4)
                        product <= partial_product;
                end
                S3_done: begin
                    done <= 1'b1;
                end
            endcase
        end
    end
endmodule
